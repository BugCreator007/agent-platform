<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- DocumentChunk 表映射：单表 CRUD 由 MyBatis-Plus BaseMapper 提供，自定义 SQL 与类型映射在下方维护 -->
<mapper namespace="com.agentplatform.modules.knowledge.infrastructure.persistence.mapper.DocumentChunkMapper">
  <select id="findByDatasetId" resultType="com.agentplatform.modules.knowledge.infrastructure.persistence.entity.DocumentChunkEntity">
    select * from document_chunks where dataset_id = #{datasetId}
  </select>

  <select id="findByDocumentId" resultType="com.agentplatform.modules.knowledge.infrastructure.persistence.entity.DocumentChunkEntity">
    select * from document_chunks where document_id = #{documentId}
  </select>

  <delete id="deleteByDocumentId">
    delete from document_chunks where document_id = #{documentId}
  </delete>
</mapper>
