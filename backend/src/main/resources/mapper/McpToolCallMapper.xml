<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.agentplatform.modules.tool.infrastructure.persistence.mapper.McpToolCallMapper">
  <select id="findTop50ByServerIdOrderByCreatedAtDesc" resultType="com.agentplatform.modules.tool.infrastructure.persistence.entity.McpToolCallEntity">
    select * from mcp_tool_calls where server_id = #{serverId} order by created_at desc limit 50
  </select>
</mapper>
