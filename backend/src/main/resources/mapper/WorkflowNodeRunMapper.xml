<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.agentplatform.modules.workflow.infrastructure.persistence.mapper.WorkflowNodeRunMapper">
  <select id="findByInstanceIdOrderByStartedAtAsc" resultType="com.agentplatform.modules.workflow.infrastructure.persistence.entity.WorkflowNodeRunEntity">
    select * from workflow_node_runs where instance_id = #{instanceId} order by started_at asc
  </select>
</mapper>
