# 复制为 deploy/server/.env 后替换所有 change-me；该文件已被 .gitignore 忽略
# 数据库
DB_USERNAME=agent
DB_PASSWORD=change-me-db-password
DB_ROOT_PASSWORD=change-me-root-password

# 安全（至少 32 字节随机值，可用 openssl rand -hex 32 生成）
JWT_SECRET=change-me-to-at-least-32-random-bytes
SECRETS_KEY=change-me-to-another-32-random-bytes
BOOTSTRAP_ADMIN_PASSWORD=admin123
DEMO_SEED=true

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Embedding（可选）
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=384

# 向量/搜索默认关闭，按需在服务器上另起 Milvus/ES 后开启
MILVUS_ENABLED=false
MILVUS_URL=http://milvus:19530
ES_ENABLED=false
ES_URL=http://elasticsearch:9200

# 存储
STORAGE_TYPE=local
STORAGE_LOCAL_ROOT=/data/files

# 跨域与访问
CORS_ALLOWED_ORIGINS=http://localhost
HTTP_PORT=80
